# Rust / VST plugin build output
vst/target/
target/

# Shared core crate: a lib, so its lock isn't versioned (and it has no deps)
core/Cargo.lock

# Rendered audio demos (reproducible via node wasm/render_demo.mjs)
*.wav

# Python / tooling cruft
__pycache__/
*.pyc
.DS_Store

